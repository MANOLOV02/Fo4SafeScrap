<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Configurations>Debug;Release;Publish</Configurations>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>SafeScrap</RootNamespace>
    <StartupObject>SafeScrap.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <!-- Identidad que ve el usuario. El NUMERO sale del Directory.Build.props del repo. -->
  <PropertyGroup>
    <Product>SafeScrap</Product>
    <AssemblyTitle>SafeScrap</AssemblyTitle>
    <Description>Fallout 4: decides which scrappable settlement objects are safe junk to scrap.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FO4_Base_Library\FO4_Base_Library.vbproj" />
  </ItemGroup>

  <!-- LINKEADO, NO REFERENCIADO: CrashReport tiene que poder reportar que FO4_Base_Library.dll no cargo.
       Misma fuente que NPC Manager, Wardrobe Manager e Item Sorter. -->
  <ItemGroup>
    <Compile Include="..\..\FO4_Base_Library\Shared\CrashReport.vb" Link="CrashReport.vb" />
    <Compile Include="..\..\FO4_Base_Library\Shared\VersionGate.vb" Link="VersionGate.vb" />
  </ItemGroup>

  <!-- Los gates de Tools\ que ejercen las leyes Friend del motor y la UI (el testigo LLAMA al sujeto). -->
  <ItemGroup>
    <InternalsVisibleTo Include="SafeScrapParityGate" />
    <InternalsVisibleTo Include="SafeScrapUiGate" />
    <InternalsVisibleTo Include="SafeScrapNativeGate" />
  </ItemGroup>

  <Import Project="..\..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />
  <Import Project="..\..\FO4_Base_Library\ConfiguracionPublish.targets" />
  <Import Project="..\..\FO4_Base_Library\IconosCompartidos.targets" />

  <!-- The F4SE plugin, embedded (Export to game installs it; GameExport.NewPlugin looks it up by this LogicalName).
       Built from SafeScrap\Native\SafeScrap_FO4; guarded by SafeScrap\Native\SafeScrapPlugin.targets. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Native\SafeScrap_FO4.dll" LogicalName="SafeScrap.Native.SafeScrap_FO4.dll" />
  </ItemGroup>
  <Import Project="..\Native\SafeScrapPlugin.targets" />

  <!-- The rules the app ships (read-only; the user's copies go to UserData\Rules). -->
  <ItemGroup>
    <Content Include="SafeScrapRules\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE_CREDITS.txt" Link="LICENSE_CREDITS.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\MIT.txt" Link="licenses\MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\Apache-2.0.txt" Link="licenses\Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\MPL-2.0.txt" Link="licenses\MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\GLFW-zlib.txt" Link="licenses\GLFW-zlib.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
